# ─── Aplicación ─────────────────────────────────────────────
# URL pública donde vive la app (sin diagonal al final)
APP_URL=https://acompana.mx
# Número de WhatsApp de contacto que aparece en la página (solo dígitos, con lada: 52 + 10 dígitos)
NEXT_PUBLIC_WHATSAPP_CONTACTO=5216180000000

# ─── Base de datos (Postgres: Neon, Supabase, Railway, etc.) ─
DATABASE_URL=postgres://usuario:contraseña@host:5432/acompana

# ─── Panel de revisión ──────────────────────────────────────
# Contraseña para entrar a /panel
ADMIN_PASSWORD=cambia-esto
# Cadena larga y aleatoria para firmar la sesión (openssl rand -hex 32)
SESSION_SECRET=
# Tu WhatsApp personal: aquí te llegan las alertas rojas y amarillas
ADMIN_WHATSAPP=5216180000000

# ─── Programador (cron) ─────────────────────────────────────
# Secreto que debe mandar el cron al llamar /api/cron
CRON_SECRET=

# ─── IA (Claude) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modelo rápido para revisar cada mensaje en busca de señales de alerta
ANTHROPIC_MODEL_RAPIDO=claude-haiku-5-5

# ─── Voz a texto (OpenAI) ───────────────────────────────────
# Entiende sus notas de voz. gpt-transcribe es el modelo vigente
# (whisper-1 y gpt-4o-transcribe se retiran el 26 de febrero de 2027).
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-transcribe

# ─── Texto a voz (cómo le responde) ─────────────────────────
# "azure" = voz con acento mexicano (recomendado). "openai" = alternativa.
VOZ_PROVEEDOR=azure
AZURE_SPEECH_KEY=
# Región de tu recurso de Azure Speech, por ejemplo: southcentralus, eastus
AZURE_SPEECH_REGION=
# Voces mexicanas: es-MX-DaliaNeural (mujer), es-MX-JorgeNeural (hombre)
AZURE_VOZ=es-MX-DaliaNeural
# Un poco más pausado que lo normal, sin exagerar
AZURE_VELOCIDAD=-5%
# Solo si VOZ_PROVEEDOR=openai (estos modelos se retiran el 6 de enero de 2027)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# ─── WhatsApp Business (API oficial de Meta) ────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Palabra que tú inventas para verificar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# "App secret" de tu app de Meta, para validar que los mensajes vienen de Meta
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_IDIOMA_PLANTILLAS=es_MX
# Nombres de las plantillas aprobadas en Meta (ver docs/plantillas-whatsapp.md)
WHATSAPP_PLANTILLA_SALUDO=saludo_diario
WHATSAPP_PLANTILLA_REINTENTO=saludo_reintento
WHATSAPP_PLANTILLA_RESUMEN=resumen_diario
WHATSAPP_PLANTILLA_ALERTA=alerta_familia
WHATSAPP_PLANTILLA_AVISO_INTERNO=aviso_interno
WHATSAPP_PLANTILLA_RECORDATORIO=recordatorio_familia
WHATSAPP_PLANTILLA_BIENVENIDA=bienvenida_familia

# ─── Cobros (Stripe) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECIO_BASICO_MXN=
STRIPE_PRECIO_COMPLETO_MXN=
STRIPE_PRECIO_BASICO_USD=
STRIPE_PRECIO_COMPLETO_USD=
